# Non-secret defaults compiled into a corporate OSII Launcher build.
VITE_OSII_REGISTRY=quay.corp.example
# Public internal URL for the reviewed, digest-pinned corporate image catalog.
VITE_OSII_CATALOG_URL=https://catalog.corp.example/osii/catalog.json
VITE_OSII_IMAGE_PREFIX=quay.corp.example/ai-ready-everything/osii
VITE_OSII_IMAGE_TAG=0.1.0
VITE_OSII_OPENAI_BASE_URL=https://models.corp.example/v1

# Optional exact defaults. If omitted, model discovery prefers names containing
# MiniLM for embeddings and Gemma 4 for chat.
VITE_OSII_OPENAI_EMBEDDING_MODEL=
VITE_OSII_OPENAI_CHAT_MODEL=
