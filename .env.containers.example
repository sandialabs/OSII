# For `make build` + `make run` (or the equivalent PowerShell commands).
# Copy this file to .env in the repository root. The desktop launcher instead
# creates a separate deployment environment for each saved library profile.
# Do not put API keys in this file when you want to enter them in Workbench Setup.

# Local images by default. Use an approved registry prefix and immutable tag
# when pulling a published release.
OSII_IMAGE_PREFIX=localhost/osii
OSII_IMAGE_TAG=latest
OSII_BASE_IMAGE=registry.access.redhat.com/ubi9/ubi:latest
OSII_PYTHON_VERSION=3.12

# Documents are mounted read-only. Setup configuration is mounted separately:
# the API can write /config/secrets.env; worker and model bridge read it only.
OSII_SOURCE_DIR=./osii-data/source
OSII_CONFIG_DIR_HOST=./osii-data/config
OSII_ALLOW_LOCAL_CONFIG_WRITES=true
# For a managed/shared deployment set the flag above to false and provide the
# API key through approved environment/secret injection instead of the UI.

# This address is resolved inside Linux containers. Never use 127.0.0.1 here
# for Ollama running on the Mac or Windows host.
# Existing connections saved in config/models.yml keep their own base_url;
# update those in Workbench Setup if they still point to 127.0.0.1.
OLLAMA_BASE_URL=http://host.containers.internal:11434
OLLAMA_EMBEDDING_MODEL=all-minilm
OLLAMA_SYNTHESIS_MODEL=llama3.2:1b
OLLAMA_CHAT_MODEL=llama3.2:1b

# Optional approved source mirrors for the repository-pinned OCR artifacts.
# OSII_TESSERACT_SOURCE_URL=https://artifact.example/tesseract-5.5.3.tar.gz
# OSII_LEPTONICA_SOURCE_URL=https://artifact.example/leptonica-1.87.0.tar.gz
# OSII_TESSDATA_BASE_URL=https://artifact.example/tessdata_fast/4.1.0
