# Personal, non-corporate OpenAI-compatible inference setup.
#
# Copy the non-secret settings below into .env. Add the API key only to .env
# (which is ignored by Git) or inject it through your shell/secret manager.
# Do not commit a filled-in copy of this file.

# Runpod Serverless vLLM endpoint. Replace ENDPOINT_ID after creating the
# endpoint in the Runpod console. The URL must include /openai/v1.
OPENAI_BASE_URL=https://api.runpod.ai/v2/ENDPOINT_ID/openai/v1

# Keep this value blank in any tracked file. The name is what OSII persists in
# its provider configuration; the key itself remains in .env or the process.
OPENAI_API_KEY=

# Use the served model name configured on the vLLM endpoint. It must match
# Runpod's --served-model-name, not necessarily its Hugging Face repository.
OPENAI_CHAT_MODEL=YOUR_SERVED_CHAT_MODEL
OPENAI_SYNTHESIS_MODEL=YOUR_SERVED_CHAT_MODEL

# `make dev` detects OPENAI_BASE_URL and makes this endpoint the preferred
# model provider. Ollama and local extractive/BM25 fallbacks remain available.

# Optional: only set these when this vLLM endpoint actually serves an embedding
# model. Otherwise OSII's local lexical embedder remains the correct baseline.
OPENAI_EMBEDDING_MODEL=YOUR_SERVED_EMBEDDING_MODEL
