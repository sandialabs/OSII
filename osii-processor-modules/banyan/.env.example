# OpenAI-compatible base URL of your corporate Nemotron Parse deployment,
# including its API prefix (for example, https://nemotron.example.com/v1).
# Leave empty until endpoint access is available.
NEMOPARSE_ENDPOINT=""
# Set this to the model identifier served by that deployment.
NEMOPARSE_MODEL="nvidia/nemotron-parse"
# Required only for authenticated hosted endpoints, such as NVIDIA API Catalog.
# Do not commit a real key to this file.
NEMOPARSE_API_KEY=""
