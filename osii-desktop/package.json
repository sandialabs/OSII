{
  "name": "osii-standalone",
  "productName": "OSII Standalone",
  "version": "0.1.0",
  "description": "Local document intelligence with portable evidence and optional AI",
  "private": true,
  "main": "main.cjs",
  "author": "OSII contributors",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "node tests/smoke.cjs",
    "package:windows": "electron-builder --win nsis --x64 --publish never",
    "package:pilot": "electron-builder --win nsis --x64 --publish never -c.win.forceCodeSigning=false",
    "package:mac-pilot": "electron-builder --mac dmg --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "playwright-core": "1.65.1"
  },
  "build": {
    "appId": "org.osii.standalone",
    "productName": "OSII Standalone",
    "asar": true,
    "beforePack": "./verify-package.cjs",
    "files": ["main.cjs", "preload.cjs", "runtime-client.cjs", "welcome.html", "welcome.css", "welcome.js", "package.json"],
    "extraResources": [{"from": "resources/runtime/osii-runtime", "to": "runtime"}],
    "directories": {"output": "../release/standalone"},
    "artifactName": "OSII-Standalone-Setup.${ext}",
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}], "icon": "icon.ico", "forceCodeSigning": true, "signAndEditExecutable": true},
    "mac": {
      "target": [{"target": "dmg", "arch": ["arm64"]}],
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "minimumSystemVersion": "15.0",
      "category": "public.app-category.productivity"
    },
    "dmg": {"artifactName": "OSII-Standalone-macOS-arm64.${ext}", "sign": false},
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
