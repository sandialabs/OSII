# OSII-local startup. Copy to .env, choose an existing source folder, run make dev.
# Windows: .\scripts\osii.ps1 dev. Configure models and processing in Setup.
# More options: docs/operations/runbook-development.md
# Shell variables override this file. Values are literal; quote paths with spaces.
# Restart after changing startup settings. Never commit credentials.

# Trust OS certificates before uv downloads Python or packages (Windows/macOS).
UV_SYSTEM_CERTS=true
# If IT supplies a PEM CA bundle, use absolute paths:
# SSL_CERT_FILE="/absolute/path/corporate-ca.pem"
# REQUESTS_CA_BUNDLE="/absolute/path/corporate-ca.pem"
# NODE_EXTRA_CA_CERTS="/absolute/path/corporate-ca.pem"

# Originals may be on a mounted share; runtime databases must stay on local disk.
OSII_SOURCE_DIR=./osii-data/source
OSII_RUNTIME_DIR=./osii-data
# Optional independent settings profile; otherwise <runtime>/config.
# OSII_CONFIG_DIR=./osii-data/config
OSII_PYTHON_VERSION=3.12

# Manifest defaults own each module's ports, capabilities, and settings.
OSII_START_PROCESSOR_MODULES=true
# Omit a module entirely (derived from its manifest service ID):
# See osii-processor-modules/<module>/README.md for deployment overrides.

# Optional NEW-profile bootstrap; prefer Setup → Model connections.
# Saved model choices remain authoritative. Keys can be replaced in Setup.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=
# OSII_CHAT_MODEL=
# OSII_EMBEDDING_MODEL=
# No provider-key file is required. Setup saves private keys in secrets.env.

# Optional application port overrides when running local and server together:
# OSII_API_PORT=8511
# OSII_DASHBOARD_PORT=5173
# OSII_SERVICE_SUPERVISOR_PORT=8510
