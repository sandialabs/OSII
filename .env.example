# Local tags by default. For a published deployment use a prefix such as
# quay.io/your-organization/osii and an immutable release tag.
OSII_IMAGE_PREFIX=localhost/osii
OSII_IMAGE_TAG=latest
# All OSII-authored images use this RHEL/UBI base. Release builders should set
# an approved immutable reference. Images install the fixed Python version below
# from the selected RHEL repositories.
OSII_BASE_IMAGE=registry.access.redhat.com/ubi9/ubi:latest
OSII_PYTHON_VERSION=3.12
# Optional byte-identical corporate mirror locations for the pinned Tesseract
# 5.5.3, Leptonica 1.87.0, and tessdata_fast 4.1.0 source artifacts.
# OSII_TESSERACT_SOURCE_URL=https://artifact.example/tesseract-5.5.3.tar.gz
# OSII_LEPTONICA_SOURCE_URL=https://artifact.example/leptonica-1.87.0.tar.gz
# OSII_TESSDATA_BASE_URL=https://artifact.example/tessdata_fast/4.1.0
OSII_API_PORT=8511
OSII_DASHBOARD_PORT=5173
OSII_TESSERACT_PORT=8080
# Optional Toolbox OpenCV/Tesseract region processor; the baseline uses 8080.
OSII_TESSERACT_OPENCV_PORT=8081
OSII_EMBEDDINGS_PORT=8085
OSII_TIKA_PORT=9998
OSII_MCP_PORT=8022
OSII_LOCAL_EXTRACTOR_PORT=8092
OSII_LOCAL_SYNTHESIZER_PORT=8093
OSII_LOCAL_ENRICHER_PORT=8094
OSII_MODEL_BRIDGE_PORT=8095
OSII_SERVICE_SUPERVISOR_PORT=8510
OSII_DEFAULT_EXTRACTOR=local.native-text
OSII_DEFAULT_SYNTHESIZER=ollama.synthesizer
OSII_DEFAULT_EMBEDDER=ollama.embedder
OSII_DEFAULT_ENRICHER=local.stats-keywords

# Folder containing the files OSII should browse and process. Relative paths
# are resolved from the repository directory. OSII mounts this read-only and
# keeps its generated database and uploads in separate managed volumes.
OSII_SOURCE_DIR=./osii-data/source
# Optional local location for `.osii` artifacts and uploads. This is useful
# when OSII_SOURCE_DIR is a read-only shared drive; keep runtime data local.
# OSII_RUNTIME_DIR=./osii-data/shared-drive
# OSII_SOURCE_KIND=shared

# Comma-separated optional Processor API service URLs. For example, a Tool Chest
# component can be published and configured here without changing OSII Core.
OSII_PROCESSORS=

# Optional provider connections. OSII bundles neither Ollama nor model weights.
# The dashboard can explicitly ask an existing Ollama service to pull only an
# administrator-allowlisted model.
# Ollama uses its native HTTP API. OSII's bundled provider service speaks a
# generic OpenAI-compatible HTTP API directly. Put
# credentials in process environment variables, not provider JSON.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=all-minilm
OLLAMA_SYNTHESIS_MODEL=llama3.2:1b
OLLAMA_CHAT_MODEL=llama3.2:1b
# Corporate administrators may extend this US-model download allowlist.
OSII_OLLAMA_ALLOWED_MODELS=all-minilm,llama3.2:1b
OSII_MODEL_BASE_URL=
OSII_CHAT_BASE_URL=
OSII_MODEL_API_KEY=
OSII_MODEL_API_KEY_ENV=OSII_MODEL_API_KEY
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_SYNTHESIS_MODEL=
OPENAI_CHAT_MODEL=

# "extractive" is fully local and model-free. Use "openai" for a configured
# OpenAI-compatible endpoint, or "ollama" for a local Ollama service.
CHAT_PROVIDER=ollama
CHAT_PROVIDER_CHAIN=ollama,extractive
CHAT_MODEL=llama3.2:1b
MCP_DEBUG=true
ATLAS_MCP_TOKEN=local-development