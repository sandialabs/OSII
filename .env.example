# OSII-server requires PostgreSQL. Do not use a corporate dataset in a public sandbox.
DATABASE_URL=postgresql+psycopg://osii:CHANGE_THIS@127.0.0.1:5432/osii_server
# Optional: let make dev start an existing local cluster. Omit for external DBs.
# OSII_DEV_POSTGRES_DIR=./osii-data/postgres
# OSII_DEV_POSTGRES_BIN=/opt/homebrew/opt/postgresql@18/bin
OSII_SOURCE_DIR=./osii-data/source
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# The file contains only the provider key, with owner-only permissions.
OSII_MODEL_API_KEY_FILE=./osii-data/provider-key
OSII_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Local loopback development only. Omit this in OpenShift.
OSII_INSECURE_LOCAL_HTTP=true
OSII_API_PORT=8512
OSII_DASHBOARD_PORT=5174
OSII_EXTRACTOR_URL=http://127.0.0.1:8192

# Independent model endpoints (API base URLs, without /chat/completions or /embeddings).
# An explicit capability URL uses ONLY that capability's key; blank key = no auth.
# Omit capability URLs to retain the existing shared endpoint/key configuration.
OSII_CHAT_BASE_URL=
OSII_CHAT_API_KEY=
OSII_CHAT_API_KEY_FILE=
OSII_EMBEDDING_BASE_URL=
OSII_EMBEDDING_API_KEY=
OSII_EMBEDDING_API_KEY_FILE=
# Optional Core RAG adapter, NOT a Toolbox processor. Cohere-compatible /rerank.
# Set both URL and exact model ID; a strategy must explicitly select reranking.
OSII_RERANK_BASE_URL=
OSII_RERANK_MODEL=
OSII_RERANK_API_KEY=
OSII_RERANK_API_KEY_FILE=

# Remembered browser sessions: absolute lifetime (1–30 days).
OSII_REMEMBER_DAYS=14

# Optional backend processor modules for development; hosted deployment is explicit.
# This does not change login, PostgreSQL access, or production service allowlists.
OSII_START_PROCESSOR_MODULES=false
# Each processor-module.toml derives OSII_ENABLE_<ID> and OSII_<ID>_PORT.
# New modules need no central code or .env.example edit. Example:
# OSII_ENABLE_COLLECTION_DATA_CARD=true
# OSII_COLLECTION_DATA_CARD_PORT=18110
# Use distinct ports if OSII-local is running at the same time.
# OSII_TESSERACT_OPENCV_PORT=18081
# OSII_READABLE_WIKI_PORT=18099
# OSII_CONCEPT_ENTITY_WIKI_PORT=18100
# OSII_CSV_EXTRACTOR_PORT=18097
# OSII_COLLECTION_TABLE_PORT=18098
# OSII_BANYAN_PORT=18101
# OSII_TIKA_ADAPTER_PORT=18102
# OSII_TIKA_SERVER_PORT=19998
# OSII_TIKA_MANAGED=false   # Use a separately managed upstream instead.
