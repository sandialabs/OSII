OSII_API_PORT=8511
OSII_DASHBOARD_PORT=5173
OSII_CHAT_PORT=8611
OSII_EXAMPLE_PROCESSOR_PORT=8091
OSII_TESSERACT_PORT=8080
OSII_EMBEDDINGS_PORT=8085
OSII_TIKA_PORT=9998
OSII_MCP_PORT=8022
OSII_LOCAL_EXTRACTOR_PORT=8092
OSII_LOCAL_SYNTHESIZER_PORT=8093
OSII_LOCAL_ENRICHER_PORT=8094
OSII_MODEL_BRIDGE_PORT=8095
OSII_DEFAULT_EXTRACTOR=local.native-text
OSII_DEFAULT_SYNTHESIZER=local.extractive-preview
OSII_DEFAULT_EMBEDDER=local.hashing
OSII_DEFAULT_ENRICHER=local.stats-keywords

# Folder containing the files OSII should browse and process. Relative paths
# are resolved from the repository directory. OSII mounts this read-only and
# keeps its generated database and uploads in separate managed volumes.
OSII_SOURCE_DIR=./osii-data/source

# Comma-separated processor service URLs. Docker Compose supplies the example
# service URL automatically when the examples profile is enabled.
OSII_PROCESSORS=

# Optional provider connections. OSII never downloads or selects a model.
# Ollama uses its native HTTP API; OpenAI-compatible and Shirty use thin
# bridges. Put credentials in process environment variables, not provider JSON.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=
OLLAMA_SYNTHESIS_MODEL=
OLLAMA_CHAT_MODEL=
OSII_MODEL_BASE_URL=
OSII_CHAT_BASE_URL=
OSII_MODEL_API_KEY=
OSII_MODEL_API_KEY_ENV=OSII_MODEL_API_KEY
OSII_SHIRTY_BRIDGE_URL=http://127.0.0.1:8096
SHIRTY_API_KEY=
SHIRTY_EMBEDDING_MODEL=
SHIRTY_SYNTHESIS_MODEL=
SHIRTY_CHAT_MODEL=

# "extractive" is fully local and model-free. Use "openai" for a configured
# OpenAI-compatible endpoint, or "ollama" for a local Ollama service.
CHAT_PROVIDER=extractive
CHAT_PROVIDER_CHAIN=extractive
CHAT_MODEL=
MCP_DEBUG=true
ATLAS_MCP_TOKEN=local-development
