# OSII-local startup configuration (no user accounts or login).
# Quick start: copy this file to .env, set OSII_SOURCE_DIR, then run make dev.
# macOS/Linux: make dev ENV_FILE=.env.personal
# Windows: .\scripts\osii.ps1 dev -EnvFile .env.personal
# The process environment overrides this file. Restart make dev after changes.
# Values are literal: do not use $VARIABLE substitution or inline comments.
# Keep credentials in ignored environment files or private key files, never Git.

# --- Corporate HTTPS trust ---------------------------------------------------
# Read from the selected env file BEFORE uv selects/downloads Python.
# Use the OS trust store if your corporate CA is already trusted there:
# UV_SYSTEM_CERTS=true
# Or use a PEM CA bundle supplied by IT (a .crt extension is fine if PEM):
# SSL_CERT_FILE="/absolute/path/to/corporate-ca-bundle.crt"
# Optional trust for Python requests and Node/npm, using the same PEM bundle:
# REQUESTS_CA_BUNDLE="/absolute/path/to/corporate-ca-bundle.crt"
# NODE_EXTRA_CA_CERTS="/absolute/path/to/corporate-ca-bundle.crt"
# Use absolute paths, forward slashes on Windows, and literal values.

# --- Files and persistent local state -----------------------------------------
# Existing readable folder, including an OS-mounted share. Originals stay intact.
# Relative paths below are relative to this checkout; quote paths with spaces.
OSII_SOURCE_DIR=./osii-data/source
# Keep runtime databases and indexes on LOCAL disk, separate from the source.
# For sidecars, reuse this path to reopen the same library; changing it selects
# another library. In PostgreSQL mode DATABASE_URL selects the library instead.
OSII_RUNTIME_DIR=./osii-data
# auto detects the source kind; use shared to explicitly label a mounted share.
OSII_SOURCE_KIND=auto
# Optional store/upload overrides; normally derived from OSII_RUNTIME_DIR.
# OSII_ROOT=./osii-data/.osii
# UPLOAD_ORIGINALS_ROOT=./osii-data/uploads
# File inventory is always included. Its canonical database must be on local
# disk outside source roots. Default: OSII_ROOT/state/inventory.sqlite3.
# OSII_INVENTORY_DB=./osii-data/inventory.sqlite3

# Sidecars remain the default. Optional PostgreSQL requires explicit schema
# initialization (and explicit import if keeping an existing library).
# See docs/reference/local-storage.md BEFORE changing this setting.
OSII_STORAGE_BACKEND=sidecar
# Used only when OSII_STORAGE_BACKEND=postgres. Keep this URL private.
# DATABASE_URL=postgresql://osii_user:replace-me@127.0.0.1:5432/osii_local

# --- Configuration profiles --------------------------------------------------
# Saved models.toml, tools.toml, and secrets.env live here, outside source files.
# A separate directory is the easiest way to try different endpoint/model defaults
# without overwriting an existing profile. The library path can stay the same.
OSII_CONFIG_DIR=./osii-data/config
# Model variables below seed a NEW models.toml. Existing saved model selections
# survive restarts; edit them in Setup or choose a new OSII_CONFIG_DIR.
# Development startup enables Setup writes. It does not create hosted accounts.
OSII_ACTIVE_PROFILE=development

# --- Intake starting points --------------------------------------------------
# These initialize the Intake form; nothing is processed until you start a run.
# Switch presets directly in Intake for each batch, then adjust individual steps.
# text           = native extraction only (no model required)
# search         = extraction + semantic embeddings
# summary-search = extraction + AI summaries + semantic embeddings
# full           = summary-search + the selected enrichment method
# Model-backed steps require a reachable configured provider and may incur costs.
OSII_INTAKE_PRESET=search
# Empty include list means all supported files. Comma-separated glob patterns,
# e.g. *.pdf,*.docx. Exclusions take precedence. Subfolders are included by default.
OSII_INTAKE_INCLUDE_PATTERNS=
OSII_INTAKE_EXCLUDE_PATTERNS=
OSII_INTAKE_INCLUDE_SUBFOLDERS=true
OSII_INTAKE_SHOW_HIDDEN=false
# Sentence-window chunking defaults: overlap must be >=0 and smaller than size.
OSII_INTAKE_CHUNK_SIZE=768
OSII_INTAKE_CHUNK_OVERLAP=128
# Optional per-intake method overrides. Empty follows Setup's selected method.
# Examples: openai.synthesizer, local.extractive-preview; local.stats-keywords,
# toolbox.readable-wiki, toolbox.concept-entity-wiki. Wiki tools need model bindings.
OSII_INTAKE_SYNTHESIZER=
OSII_INTAKE_ENRICHER=
# Native text is the first pass; extraction routes/OCR fallbacks are edited in Setup.
OSII_DEFAULT_EXTRACTOR=local.native-text
OSII_DEFAULT_ENRICHER=local.stats-keywords

# --- OpenAI-compatible providers (OpenRouter or corporate endpoints) ----------
# API base URL only, e.g. https://openrouter.ai/api/v1, without /chat/completions.
# These defaults apply when capability-specific URLs are empty.
# No URL means no remote provider by default. Use Setup for saved connections.
# Setup's saved default chooses the chat provider; no separate routing flags are needed.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Prefer a private key file to storing a secret inline. Leave inline KEY blank when using KEY_FILE.
# OPENAI_API_KEY_FILE=/absolute/private/path/provider-key
# Seed exact API model IDs, not friendly labels. Changing embedding model requires
# rebuilding embeddings; indexes from different vector spaces are incompatible.
OSII_CHAT_MODEL=
OSII_EMBEDDING_MODEL=

# Independent capability URLs allow chat and embedding to use different services.
# Explicit capability URL = use ONLY that capability's key/file. It deliberately
# does not inherit OPENAI_API_KEY. Blank key with an explicit URL means no auth.
# For separate corporate endpoints, set each URL, exact model ID above, and key.
OSII_CHAT_BASE_URL=
OSII_CHAT_API_KEY=
OSII_CHAT_API_KEY_FILE=
OSII_EMBEDDING_BASE_URL=
OSII_EMBEDDING_API_KEY=
OSII_EMBEDDING_API_KEY_FILE=

# --- Optional Core RAG reranking ---------------------------------------------
# Separate Cohere-compatible /rerank endpoint, not a processor module. Leave
# empty unless configured. A RAG strategy must explicitly request reranking.
# Reranking never inherits chat/embedding credentials.
OSII_RERANK_BASE_URL=
OSII_RERANK_MODEL=
OSII_RERANK_API_KEY=
OSII_RERANK_API_KEY_FILE=

# --- Optional local Ollama ---------------------------------------------------
# OSII starts the bridge, not Ollama. Install/start Ollama and pull these models
# yourself if wanted. No model weights are downloaded by make dev.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=all-minilm
OLLAMA_SYNTHESIS_MODEL=llama3.2:1b
OLLAMA_CHAT_MODEL=llama3.2:1b
# Comma-separated models Setup may explicitly request to download; empty = none.
OSII_OLLAMA_ALLOWED_MODELS=

# --- Host services and processor modules -----------------------------------------------
# uv obtains this Python version and installs each project's dependencies.
OSII_PYTHON_VERSION=3.12
# All available Processor module hosts start by default in isolated environments.
# false leaves them stopped; Setup can start them on demand. Starting a service
# does not select it for a run or invoke a model. Native Tesseract is required
# for OCR. Nemotron also needs the processor module project's own provider configuration.
OSII_START_PROCESSOR_MODULES=true
# Optional trusted module root (defaults to ./osii-processor-modules).
# OSII_PROCESSOR_MODULES_DIR=/path/to/processor-modules
# Switches are derived from each processor-module.toml service ID. A contributor
# adding collection-data-card automatically gets OSII_ENABLE_COLLECTION_DATA_CARD
# and OSII_COLLECTION_DATA_CARD_PORT; no central code or template edit is required.
# Omit individual modules: false skips their dependency installation, registration,
# and startup. Restart make dev after changing these switches.
OSII_ENABLE_TIKA=true
OSII_ENABLE_BANYAN=true
OSII_ENABLE_TESSERACT_OPENCV=true
OSII_ENABLE_READABLE_WIKI=true
OSII_ENABLE_CONCEPT_ENTITY_WIKI=true
OSII_ENABLE_CSV_EXTRACTOR=true
OSII_ENABLE_COLLECTION_TABLE=true
# Tika includes a cached Apache runtime and Java in its isolated environment.
# First startup needs network access; no separate Java or Tika install is needed.
# Set false to use only an external Tika server configured in Setup.
OSII_TIKA_MANAGED=true
OSII_TIKA_SERVER_PORT=9998
# Optional shared/offline cache location; the jar must match the pinned checksum.
# OSII_TIKA_CACHE_DIR=/path/to/tika-cache
# Additional Processor API URLs, comma-separated; bundled services are registered
# automatically. External Tika may be configured separately; containers are not started.
OSII_PROCESSORS=
# Application HTTP ports (bound to loopback). Keep distinct from server checkout.
OSII_API_PORT=8511
OSII_DASHBOARD_PORT=5173
OSII_SERVICE_SUPERVISOR_PORT=8510
OSII_MCP_PORT=8022
# Baseline native extraction, full-page Tesseract, cited preview, hashing, statistics.
OSII_LOCAL_EXTRACTOR_PORT=8092
OSII_TESSERACT_PORT=8080
OSII_LOCAL_SYNTHESIZER_PORT=8093
OSII_EMBEDDINGS_PORT=8085
OSII_LOCAL_ENRICHER_PORT=8094
# Ollama/OpenAI-compatible bridge; this is not itself a model server.
OSII_MODEL_BRIDGE_PORT=8095
# Processor modules: region OCR, CSV extraction, table enrichment, two wiki tools, Banyan.
OSII_TESSERACT_OPENCV_PORT=8081
OSII_CSV_EXTRACTOR_PORT=8097
OSII_COLLECTION_TABLE_PORT=8098
OSII_READABLE_WIKI_PORT=8099
OSII_CONCEPT_ENTITY_WIKI_PORT=8100
# Nemotron endpoint/model/key belong in osii-processor-modules/banyan/.env.
OSII_BANYAN_PORT=8101
# Port of the Tika Processor API adapter (Apache Tika uses OSII_TIKA_SERVER_PORT).
# Setup can override the upstream address when using an external Tika server.
OSII_TIKA_ADAPTER_PORT=8102
# MCP's internal client token and diagnostic logging, not OSII user authentication.
ATLAS_MCP_TOKEN=local-development
MCP_DEBUG=false
